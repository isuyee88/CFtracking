# -----------------------------------------------------------------------------
# Git Tracking Policy (runtime-first)
# Keep runtime source/config in Git; ignore generated artifacts and local tooling
# -----------------------------------------------------------------------------

# Dependencies
node_modules/
frontend/node_modules/
.pnp
.pnp.js
jspm_packages/

# Build outputs / deploy bundles
/dist/
/build/
/wrangler-out/
/dist-*/
/frontend/dist/
/frontend/output/

# Test, benchmark and analysis artifacts
/test-results/
/performance-results/
/analysis/
/output/
/.playwright-cli/
/frontend/lighthouse-*/
/frontend/playwright-screenshots/
/frontend/.lighthouseci/

# Generated reports / exports (root)
/lighthouse-*.json
/keitaro-*.json
/output_*.html
/report.html
/report.json
/test-*.png
/verify-dashboard.png
/wrangler-deploy-log.txt

# Non-runtime research / snapshots
/affiliate-pages/
/image-processor/
/keitaro-images/
/keitaro-screenshots/
/keitaro-screenshots-detailed/
/spa-performance-test/
/ssr-performance-test/
/version_20_code/
/trae-self-evolving/

# Archives and temp bundles
/*.zip
/*.tgz

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
pnpm-debug.log*

# Runtime data
pids/
*.pid
*.seed
*.pid.lock

# Coverage and caches
coverage/
*.lcov
.nyc_output/
*.tsbuildinfo
.npm/
.eslintcache

# Wrangler local state
.wrangler/
wrangler.toml.bak

# Environment variables / secrets
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.dev.vars
frontend/.env*
!frontend/.env.example

# AI agent / IDE tool directories (not required to run app)
.adal/
.agents/
.augment/
.bob/
.claude/
.codebuddy/
.commandcode/
.continue/
.cortex/
.crush/
.factory/
.goose/
.iflow/
.junie/
.kilocode/
.kiro/
.kode/
.mcpjam/
.mux/
.neovate/
.openhands/
.pi/
.pochi/
.qoder/
.qwen/
.roo/
.trae/
.vibe/
.windsurf/
.zencoder/

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db

# Editor / workspace files
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~

# -----------------------------------------------------------------------------
# Runtime-critical paths (documented)
# - src/**
# - frontend/src/**
# - frontend/public/**
# - schema/**
# - scripts/**
# - wrangler.toml / wrangler.dev.toml
# - package*.json / tsconfig / vite / vitest configs
# -----------------------------------------------------------------------------
