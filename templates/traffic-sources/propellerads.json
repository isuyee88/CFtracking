    "subId5": "var4",
    "country": "{country}",
    "device": "{device}",
    "os": "{os}",
    "browser": "{browser}"
  },
  "macros": {
    "{zoneid}": "Campaign/Zone ID",
    "{clickid}": "Click ID for tracking",
    "{cost}": "Cost per click",
    "{country}": "2-letter country code (US, GB, etc)",
    "{device}": "Device type (mobile, tablet, desktop)",
    "{os}": "Operating system",
    "{browser}": "Browser name",
    "{var1}": "Custom variable 1",
    "{var2}": "Custom variable 2",
    "{var3}": "Custom variable 3",
    "{var4}": "Custom variable 4"
  },
  "postbackTemplate": "https://ssp-api.propellerads.com/v1/cpa_goal?click_id={clickId}&amount={revenue}&currency={currency}&status={status}",
  "postbackMacros": {
    "{clickId}": "Original click ID from PropellerAds",
    "{revenue}": "Conversion revenue/payout",
    "{currency}": "Currency code (USD, EUR, etc)",
    "{status}": "approved or rejected"
  },
  "trackingUrlExample": "https://your-tracker.com/click?campaign={campaignId}&source=propellerads&cid={clickid}&zoneid={zoneid}&cost={cost}&country={country}&device={device}",
  "notes": [
