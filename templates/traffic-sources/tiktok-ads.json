    "ttclid": "TikTok click ID",
    "value": "Conversion value",
    "currency": "Currency code"
  },
  "trackingUrlExample": "https://your-tracker.com/click?campaign={campaignId}&source=tiktok&ttclid={ttclid}&campaign_id=__CAMPAIGN_ID__&aid=__AID__&cid=__CID__",
