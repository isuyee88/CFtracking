    "__CAMPAIGN_NAME__": "Campaign name",
    "__AID__": "Ad Group ID",
    "__ADGROUP_NAME__": "Ad Group name",
    "__CID__": "Creative/Ad ID",
    "__CREATIVE_NAME__": "Creative name",
    "__PLACEMENT__": "Placement (TikTok, Pangle, etc)",
    "__OS__": "Operating system",
    "__CARRIER__": "Mobile carrier"
  },
  "postbackTemplate": "https://business-api.tiktok.com/open_api/v1.3/event/track/",
