    "{clickId}": "Original Taboola click ID (tblci parameter)",
    "{revenue}": "Conversion value in USD"
  },
  "trackingUrlExample": "https://your-tracker.com/click?campaign={campaignId}&source=taboola&tblci={click_id}&site={site}&platform={platform}&cpc={cpc}",
  "notes": [
    "Taboola uses 'tblci' parameter for click ID",
