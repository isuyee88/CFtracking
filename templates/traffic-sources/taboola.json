{
  "id": "taboola",
  "name": "Taboola",
  "category": "native",
  "description": "Taboola native advertising and content discovery platform",
  "homepage": "https://taboola.com",
  "documentation": "https://help.taboola.com",
  "parameters": {
    "clickId": "tblci",
    "campaignId": "campaign",
    "siteId": "site",
    "platform": "platform",
    "cost": "cpc"
  },
  "macros": {
    "{click_id}": "Taboola click ID",
    "{campaign_id}": "Campaign ID",
    "{campaign_item_id}": "Campaign item ID",
    "{site}": "Publisher site",
    "{site_id}": "Publisher site ID",
    "{platform}": "Device platform (Desktop, Mobile, Tablet)",
    "{country}": "Country code",
    "{region}": "Region code",
    "{city}": "City name",
    "{cpc}": "Cost per click"
  },
  "postbackTemplate": "https://trc.taboola.com/actions-handler/log/3/s2s-action?click-id={clickId}&name=conversion&revenue={revenue}",
