/assets/*
  Cache-Control: public, max-age=31536000, immutable

/
  Cache-Control: no-cache, must-revalidate

/index.html
  Cache-Control: no-cache, must-revalidate

/exported-reports
  Cache-Control: no-cache, must-revalidate

/favicon.svg
  Cache-Control: public, max-age=604800, must-revalidate

/icons.svg
  Cache-Control: public, max-age=604800, must-revalidate

/pwa-192x192.svg
  Cache-Control: public, max-age=604800, must-revalidate

/pwa-512x512.svg
  Cache-Control: public, max-age=604800, must-revalidate

/robots.txt
  Cache-Control: public, max-age=3600, must-revalidate
