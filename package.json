{
  "name": "cf-tracking-ssr",
  "version": "2.0.0",
  "description": "Traffic tracking and rule engine system with SSR + DO + SSE",
  "type": "module",
  "main": "dist/worker.js",
  "scripts": {
    "dev": "vite",
    "dev:worker": "wrangler dev",
    "build": "npm run build:client && npm run build:server",
    "build:client": "vite build --outDir dist/client",
    "build:server": "cross-env BUILD_MODE=ssr vite build --outDir dist/server --ssr src/ssr/entry-server.tsx",
    "build:force": "vite build --outDir dist/client",
    "deploy": "npm run build && node scripts/generate-deploy-message.js && wrangler deploy --message \"$(Get-Content -Raw dist/deploy-message.txt)\"",
    "deploy:bash": "npm run build && node scripts/generate-deploy-message.js && wrangler deploy --message $(cat dist/deploy-message.txt)",
    "deploy:with-commit": "npm run build && node scripts/deploy-with-git-commit.js",
    "preview": "wrangler dev",
    "lint": "eslint src --ext .ts,.tsx",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "db:migrate": "wrangler d1 execute cf-tracking-db --file=./schema/migrations/001_init.sql",
    "db:migrate:local": "wrangler d1 execute cf-tracking-db --local --file=./schema/migrations/001_init.sql",
    "test": "vitest"
  },
  "dependencies": {
    "antd": "^6.3.2",
    "axios": "^1.13.6",
    "hono": "^4.6.0",
    "lucide-react": "^0.469.0",
    "puppeteer": "^24.40.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-icons": "^5.6.0",
    "react-router-dom": "^7.13.1",
    "recharts": "^3.8.0",
    "tailwind-merge": "^2.6.0",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241230.0",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "better-sqlite3": "^12.8.0",
    "cross-env": "^10.1.0",
    "puppeteer-core": "^24.39.1",
    "typescript": "^5.7.0",
    "vite": "^5.4.21",
    "vitest": "^2.1.0",
    "wrangler": "^4.76.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
