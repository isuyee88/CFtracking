{
  "name": "cf-tracking",
  "version": "1.0.0",
  "description": "Traffic tracking and rule engine system built on Cloudflare Workers",
  "main": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "npm run build:frontend && wrangler deploy",
    "prebuild:frontend": "cd frontend && npm install",
    "build:frontend": "cd frontend && npm run build",
    "build:backend": "tsc --noEmit",
    "build": "npm run build:backend && npm run build:frontend",
    "db:migrate": "wrangler d1 execute cf-tracking-db --file=./schema/migrations/001_init.sql",
    "db:migrate:local": "wrangler d1 execute cf-tracking-db --local --file=./schema/migrations/001_init.sql",
    "lint": "eslint src --ext .ts",
    "test": "vitest"
  },
  "dependencies": {
    "antd": "^6.3.2",
    "axios": "^1.13.6",
    "hono": "^4.6.0",
    "playwright": "^1.58.2",
    "react-icons": "^5.6.0",
    "react-router-dom": "^7.13.1",
    "recharts": "^3.8.0",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241230.0",
    "@types/node": "^22.10.0",
    "better-sqlite3": "^12.8.0",
    "puppeteer-core": "^24.39.1",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0",
    "wrangler": "^4.76.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
